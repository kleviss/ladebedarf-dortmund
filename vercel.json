{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/berichte",
      "destination": "/dortmund/berichte",
      "permanent": true
    },
    {
      "source": "/berichte.html",
      "destination": "/dortmund/berichte",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
